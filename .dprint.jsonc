{
  "json": {
    "trailingCommas": "never"
  },
  "biome": {
    "indentStyle": "space",
    "javascript.quoteStyle": "single"
  },
  "excludes": [
    "CHANGELOG.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.23.2.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/ruff-0.8.5.wasm",
    "https://plugins.dprint.dev/biome-0.13.9.wasm"
  ]
}
